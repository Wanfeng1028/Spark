{
  "expo": {
    "name": "Spark",
    "slug": "spark-mobile",
    "scheme": "spark",
    "version": "0.1.0",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F7F7F7",
    "platforms": ["ios", "android", "web"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sparkapp.mobile"
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "package": "com.sparkapp.mobile"
    },
    "plugins": ["expo-secure-store", "expo-status-bar", ["expo-image-picker", { "photosPermission": "允许 Spark 读取图片以附加到消息" }]]
  }
}
