{
  "expo": {
    "name": "Spark",
    "slug": "spark-mobile",
    "scheme": "spark",
    "version": "0.1.0",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F7F7F7",
    "platforms": ["ios", "android"],
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "edgeToEdgeEnabled": true
    },
    "plugins": ["expo-secure-store", "expo-status-bar"]
  }
}
