{
  "name": "@spark/sdk",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Spark 薄客户端 SDK（L2 层，工单 14.3/14.4）：两个子入口——`.`（HTTP，零 engine 依赖）与 `./inprocess`（进程内直连引擎，engine 为 optional peer）；均为装配 + 便利分组，零业务逻辑",
  "author": "Wanfeng1028",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./inprocess": {
      "types": "./src/inprocess.ts",
      "import": "./src/inprocess.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./inprocess": {
        "types": "./dist/inprocess.d.ts",
        "import": "./dist/inprocess.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wanfeng1028/Spark.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/Wanfeng1028/Spark/issues"
  },
  "homepage": "https://github.com/Wanfeng1028/Spark#readme",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "example": "tsx examples/minimal.ts"
  },
  "dependencies": {
    "@spark/protocol": "workspace:*"
  },
  "peerDependencies": {
    "@spark/engine": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@spark/engine": {
      "optional": true
    }
  },
  "devDependencies": {
    "@spark/engine": "workspace:*",
    "@types/node": "^24",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "contributors": [
    "Jules (AI Assistant)",
    "Doubao (AI Assistant)",
    "opencode (AI Assistant)"
  ]
}
