// 工单 14.1 第二批：未引用导出/依赖扫描（ARCHITECTURE §9.6 硬检查项）。
// 每一处 entry / ignore 都写明理由；首份报告的逐项裁决表见 doc/02 §4.6.3。
{
  "$schema": "https://unpkg.com/knip@6/schema.json",

  // 框架约定与人工运行脚本：knip 只跟静态 import 图，看不到字符串引用与 CLI 直跑。
  // 入口必须放到各自 workspace 节下（顶层 entry 对这些文件不生效，knip 会给 configuration hint）：
  // - Taro 4：app.config.ts 以字符串列页面路径，故 app/pages/config 均为入口（页面可达后，
  //   其引用的 components/store/theme/transport 也随之可达，首份报告里那 15 个 miniapp 文件即消失）
  // - CLI 预览脚本：人工 `tsx apps/cli/scripts/preview-*.mts` 运行，不被任何模块 import
  "workspaces": {
    "apps/miniapp": {
      "entry": [
        "src/app.tsx",
        "src/app.config.ts",
        "src/pages/*/index.tsx",
        "src/pages/*/index.config.ts",
        "config/index.ts"
      ],
      // 2026-09-09 h5 联调批新增的隐式引用（与下方顶层 @tarojs/* 豁免同性质，knip 只跟
      // 静态 import 图看不到）：
      // - @tarojs/plugin-platform-h5：h5 构建目标（dev:h5 / taro build --type h5）由
      //   Taro CLI 按平台装载，模块图不 import 它
      // - @pmmmwh/react-refresh-webpack-plugin 与 react-refresh：Taro H5 dev 模式的
      //   fast-refresh 由 plugin-framework-react 以裸 require 装载（dist setPlugin 内
      //   require('@pmmmwh/react-refresh-webpack-plugin')）+ babel-preset-taro 的
      //   react-refresh/babel（TARO_PLATFORM=web 时注入），均非静态引用
      // - react-dom 与 @types/react-dom：Taro H5 构建经 webpack alias 消费
      //   （plugin-framework-react 的 H5 分支 resolveSync('react-dom') 后 alias 成
      //   'react-dom$'，缺失时 resolveSync 返回 null → webpack alias schema 不收 null，
      //   构建直接炸"Invalid configuration object"）——运行时被 alias 引走而非被
      //   import，knip 视角即未使用；weapp 分支 alias 到 @tarojs/react 故无需它
      "ignoreDependencies": [
        "@tarojs/plugin-platform-h5",
        "@pmmmwh/react-refresh-webpack-plugin",
        "react-refresh",
        "react-dom",
        "@types/react-dom"
      ]
    },
    "apps/docs": {
      // VitePress 约定入口与词表页生成器（分别由框架约定与 `gen:events` 脚本引用，不被任何模块 import）
      "entry": [".vitepress/config.ts", "scripts/gen-events.ts"]
    },
    "apps/cli": {
      "entry": ["scripts/preview-boot.mts", "scripts/preview-pane.mts"]
    },
    "packages/sdk": {
      // 最小连接示例与嵌入示例（工单 14.3/14.4）：人工 `pnpm --filter @spark/sdk example|embed`
      // 直跑，不被任何模块 import
      "entry": ["examples/minimal.ts", "examples/embed.ts"]
    },
    "examples/sdk-bot": {
      // 脚本入口（package.json 的 start 用 tsx 直跑；bot.ts 被 main.ts 与测试 import）
      "entry": ["main.ts"]
    },
    "examples/sdk-tui": {
      // 脚本入口（start 用 tsx 直跑 tui.tsx；Ink 应用在模块顶层 render）
      "entry": ["tui.tsx"]
    },
    "examples/sdk-viewer": {
      // index.html 用 <script type="module" src="./main.ts"> 引入——knip 不解析 HTML，故登记为入口
      "entry": ["main.ts", "vite.config.ts"]
    }
  },

  // 死代码与实验残留：AGENTS §2.10 —— AI 无权删除任何文件，一律冻结待人类五层级确认。
  // 登记去向见 doc/02 阶段十 10.30 行（本批新增四处候选：cli Sidebar、web Titlebar、
  // web UsageBar、cli spike-ime-stdin）。此处 ignore 只是"不让门禁长期红灯"，不等于判决保留。
  "ignore": [
    "apps/cli/src/components/StatusBar.tsx",
    "apps/cli/src/components/Sidebar.tsx",
    "apps/web/src/components/layout/Titlebar.tsx",
    "apps/web/src/features/chat/UsageBar.tsx",
    "apps/cli/scripts/spike-ime-stdin.mts",
    "examples/spike-pi-ai/**"
  ],

  // 字符串/隐式引用，静态分析看不到：
  // - playwright-core：apps/cli 把引擎一起 bundle，scripts/build.mjs 以 external: ['playwright-core']
  //   字符串外置（其内部对 chromium-bidi 的懒加载 require 无法静态解析），运行时经依赖解析
  // - @tarojs/*：apps/miniapp/config/index.ts 的 plugins 数组以字符串列出；@babel/runtime 与
  //   @tarojs/react·runtime 是 Taro 编译产物的隐式运行时依赖
  "ignoreDependencies": [
    "playwright-core",
    "@babel/runtime",
    "@tarojs/plugin-framework-react",
    "@tarojs/plugin-platform-weapp",
    "@tarojs/react",
    "@tarojs/runtime",
    "@tarojs/webpack5-runner"
  ],

  // 按文件排除特定问题类型（knip v6 无 ignoreUnlisted 键）：
  // - apps/mobile/app.json 的 unlisted：knip 的 Expo 插件按约定推导出 expo-updates/expo-system-ui，
  //   但本仓 plugins 实为 expo-secure-store/expo-status-bar（均在依赖里）、全仓 grep 零命中且不启用 OTA；
  //   将来启用 OTA 则装上并删掉本条。
  // - copy-in 组件的上游 API 面：`components/ui/*` 是 AI Elements/shadcn 的 copy-in 件
  //   （frontend-component skill 纪律），**导出面与上游保持一致**便于后续复用与升级对照，
  //   故本目录的未引用导出/类型不算缺陷（例：DialogTrigger/DialogClose/buttonVariants 上游有、本仓未用）。
  "ignoreIssues": {
    "apps/mobile/app.json": ["unlisted"],
    "apps/web/src/components/ui/**": ["exports", "types"]
  },

  // bash 工具文案里出现的 Windows 内建命令名，不是本仓需要安装的可执行文件
  "ignoreBinaries": ["where"],

  // 门禁的问题类型（工单 14.1 第三批起含 exports/types）：未引用导出与类型也是硬门——
  // 新增导出要么被消费，要么在裁决表里留理由（doc/02 §4.6.3），不允许悄无声息地胀大公共面。
  "include": [
    "files",
    "dependencies",
    "devDependencies",
    "unlisted",
    "binaries",
    "duplicates",
    "exports",
    "types"
  ]
}
